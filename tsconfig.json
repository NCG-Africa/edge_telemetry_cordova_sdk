{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "ES2017",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "test/**/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "vitest.config.mts",
    "eslint.config.mjs"
  ],
  "exclude": [
    "test/consumer"
  ]
}
